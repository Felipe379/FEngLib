<UserControl x:Class="FEngViewer.WPF.Views.PackageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FEngViewer.WPF.Views"
             xmlns:viewModels="clr-namespace:FEngViewer.WPF.ViewModels"
             xmlns:packageView="clr-namespace:FEngViewer.WPF.ViewModels.PackageView"
             xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=PresentationFramework"
             xmlns:uiHelpers="clr-namespace:FEngViewer.WPF.UIHelpers"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="640" d:DesignWidth="1280"
             d:DataContext="{d:DesignInstance viewModels:PackageViewModel, IsDesignTimeCreatable=True}">
    <Grid d:Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width=".75*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TreeView ItemsSource="{Binding TreeRoots}">
            <TreeView.Resources>
                <!-- Begin Styles -->

                <!-- Set a default margin for icons. We can override it if necessary -->
                <Style TargetType="{x:Type iconPacks:PackIconFontAwesome}">
                    <Setter Property="Margin" Value="0,0,4,0"></Setter>
                </Style>

                <!-- Set default properties for TreeViewItems -->
                <Style TargetType="{x:Type TreeViewItem}">
                    <Style.Setters>
                        <Setter Property="Margin" Value="0,5,0,0"></Setter>
                    </Style.Setters>
                    <Style.Triggers>
                        <Trigger Property="componentModel:DesignerProperties.IsInDesignMode" Value="True">
                            <Setter Property="IsExpanded" Value="True"></Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <!-- End Styles -->

                <!-- Begin Data Templates -->

                <!-- Package (Root) -->
                <HierarchicalDataTemplate DataType="{x:Type packageView:PackageFacade}" ItemsSource="{Binding TreeNodes}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconFontAwesome Kind="ProjectDiagramSolid" />
                        <TextBlock Text="{Binding Name}"></TextBlock>
                    </StackPanel>
                </HierarchicalDataTemplate>

                <!-- Resource Requests -->
                <HierarchicalDataTemplate DataType="{x:Type packageView:ResourceRequestFolder}" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconFontAwesome Kind="FileArchiveSolid" />
                        <TextBlock Text="{Binding Name}"></TextBlock>
                    </StackPanel>
                </HierarchicalDataTemplate>
                <DataTemplate DataType="{x:Type viewModels:ResourceRequestViewModel}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconFontAwesome Kind="{Binding Icon}"></iconPacks:PackIconFontAwesome>
                        <TextBlock Text="{Binding Name}"></TextBlock>
                    </StackPanel>
                </DataTemplate>

                <!-- Message Definitions -->
                <DataTemplate DataType="{x:Type viewModels:MessageDefinitionViewModel}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconFontAwesome Kind="EnvelopeSolid" />
                        <TextBlock Text="{Binding Name}"></TextBlock>
                    </StackPanel>
                </DataTemplate>

                <HierarchicalDataTemplate DataType="{x:Type packageView:MessageDefinitionsFolder}" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconFontAwesome Kind="EnvelopeSolid" />
                        <TextBlock Text="{Binding Name}"></TextBlock>
                    </StackPanel>
                </HierarchicalDataTemplate>

                <!-- Message Responses -->
                <HierarchicalDataTemplate DataType="{x:Type viewModels:MessageResponseViewModel}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconFontAwesome Kind="EnvelopeSolid" />
                        <TextBlock Text="{Binding MessageName}"></TextBlock>
                    </StackPanel>
                </HierarchicalDataTemplate>

                <HierarchicalDataTemplate DataType="{x:Type packageView:MessageResponsesFolder}" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconFontAwesome Kind="ExclamationSolid" />
                        <TextBlock Text="{Binding Name}"></TextBlock>
                    </StackPanel>
                </HierarchicalDataTemplate>

                <!-- Objects -->
                <HierarchicalDataTemplate DataType="{x:Type viewModels:GroupViewModel}" ItemsSource="{Binding TreeNodes}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconFontAwesome Kind="LayerGroupSolid"></iconPacks:PackIconFontAwesome>
                        <TextBlock Text="{Binding Facade.Name}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Facade.IsNameExplicit}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold"></Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </HierarchicalDataTemplate>

                <HierarchicalDataTemplate DataType="{x:Type viewModels:ObjectViewModel}" ItemsSource="{Binding TreeNodes}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconFontAwesome Kind="{Binding TreeIcon}"></iconPacks:PackIconFontAwesome>
                        <TextBlock Text="{Binding Facade.Name}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Facade.IsNameExplicit}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold"></Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </HierarchicalDataTemplate>

                <!-- End Data Templates -->
            </TreeView.Resources>
        </TreeView>
    </Grid>
</UserControl>
