<ContextMenu x:Class="FEngViewer.WPF.Controls.CommandableContextMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FEngViewer.WPF.Controls"
             xmlns:uiHelpers="clr-namespace:FEngViewer.WPF.UIHelpers"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ContextMenu.Style>
        <StaticResource ResourceKey="MahApps.Styles.ContextMenu"></StaticResource>
    </ContextMenu.Style>
    <ContextMenu.ItemContainerStyle>
        <Style TargetType="MenuItem" BasedOn="{StaticResource MahApps.Styles.MenuItem}">
            <Setter Property="Command" Value="{Binding Command}"></Setter>
        </Style>
    </ContextMenu.ItemContainerStyle>
    <ContextMenu.Resources>
        <DataTemplate DataType="{x:Type uiHelpers:CommandOption}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                <iconPacks:PackIconFontAwesome Kind="{Binding Icon}" />
                <TextBlock Text="{Binding Label}" />
            </StackPanel>
        </DataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type uiHelpers:MultiCommandOption}" ItemsSource="{Binding SubCommands}">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconFontAwesome Kind="{Binding Icon}" />
                <TextBlock Text="{Binding Label}" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </ContextMenu.Resources>
</ContextMenu>